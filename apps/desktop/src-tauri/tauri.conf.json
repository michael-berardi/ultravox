{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UltraVox",
  "identifier": "com.imploselabs.ultravox",
  "version": "0.9.0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UltraVox Light",
        "width": 450,
        "height": 650,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "visible": true,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 25 },
        "focus": true
      }
    ],
    "security": { "csp": null, "capabilities": ["default"] },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true,
      "tooltip": "UltraVox Light"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "resources": {"../../../skills/dictionary-review/SKILL.md": "skills/dictionary-review/SKILL.md"},
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "Copyright © 2026 UltraVox contributors",
    "category": "Productivity",
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "shortDescription": "Private on-device transcription",
    "longDescription": "UltraVox Light provides private real-time audio transcription using downloadable on-device models."
  }
}
