{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the UltraVox desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "clipboard-manager:default",
    "dialog:allow-open"
  ],
  "commands": [
    "get_app_info",
    "get_app_status",
    "get_settings",
    "set_settings",
    "get_model_catalog",
    "get_download_progress",
    "get_downloads",
    "start_download",
    "prepare_model",
    "is_model_downloaded",
    "get_model_progress",
    "cancel_download",
    "list_recordings",
    "search_recordings",
    "get_recording",
    "update_recording",
    "delete_recording",
    "delete_all_recordings",
    "start_recording",
    "stop_recording",
    "import_url",
    "start_meeting",
    "stop_meeting",
    "get_transcription_status",
    "retry_transcription",
    "get_shortcut_settings",
    "set_shortcut_settings",
    "get_audio_devices",
    "get_audio_input_config",
    "export_recording",
    "bridge_version",
    "get_caret_position",
    "paste_text",
    "copy_to_clipboard",
    "start_modifier_hotkey",
    "start_key_combination_hotkey",
    "stop_key_combination_hotkey",
    "stop_modifier_hotkey",
    "show_indicator",
    "hide_indicator",
    "transcribe_file"
  ]
}
