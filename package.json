{
  "name": "dictator",
  "private": true,
  "version": "0.1.0",
  "description": "Dictator monorepo — Swift baseline and Rust/Tauri v2 rewrite",
  "scripts": {
    "desktop:dev": "pnpm --filter dictator-desktop tauri dev",
    "desktop:build": "pnpm --filter dictator-desktop tauri build",
    "desktop:check": "pnpm --filter dictator-desktop check",
    "desktop:tauri:check": "pnpm --filter dictator-desktop tauri check",
    "cargo:fmt": "cargo fmt --all",
    "cargo:check": "cargo check --workspace",
    "pkg:build": "./Scripts/build-pkg.sh",
    "pkg:verify": "./Scripts/verify-pkg.sh",
    "release:package": "./Scripts/package-release.sh",
    "release:publish": "./Scripts/publish-release.sh"
  },
  "devDependencies": {},
  "packageManager": "pnpm@10.27.0"
}
